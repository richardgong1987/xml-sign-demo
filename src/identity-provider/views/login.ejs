<%- include("_head", { title: "Demo OpenAM sign-in" }) %>

<h1>Demo OpenAM (IdP)</h1>

<p>Received an AuthnRequest from the service provider:</p>
<ul>
    <li>SP entity ID: <code><%= serviceProviderEntityId %></code></li>
    <li>Request ID: <code><%= authnRequestId %></code></li>
    <li>RelayState: <code><%= relayState || "(empty)" %></code></li>
</ul>

<form method="post" action="/idp/login">
    <input type="hidden" name="authnRequestId" value="<%= authnRequestId %>">
    <input type="hidden" name="serviceProviderEntityId" value="<%= serviceProviderEntityId %>">
    <input type="hidden" name="relayState" value="<%= relayState %>">

    <h2>Pick a demo user</h2>
    <ul>
        <% users.forEach((user) => { %>
        <li>
            <button type="submit" name="uid" value="<%= user.uid %>">
                Sign in as <%= user.uid %> (role=<%= user.role %>)
            </button>
        </li>
        <% }) %>
    </ul>

    <label>
        <input type="checkbox" name="tamper" value="on">
        Simulate a man-in-the-middle: change role to administrator after signing
    </label>
</form>

<%- include("_foot") %>

<%- include("_head", { title: "Returning to the service provider" }) %>

<h1>The IdP issued a SAMLResponse</h1>

<p>HTTP-POST binding: the IdP cannot call the SP directly, so the browser POSTs the
    SAMLResponse to <code><%= assertionConsumerServiceUrl %></code></p>

<form id="saml-post-form" method="post" action="<%= assertionConsumerServiceUrl %>">
    <input type="hidden" name="SAMLResponse" value="<%= samlResponseBase64 %>">
    <input type="hidden" name="RelayState" value="<%= relayState %>">
    <noscript>
        <button type="submit">Continue</button>
    </noscript>
</form>

<script>document.getElementById("saml-post-form").submit();</script>

<%- include("_foot") %>

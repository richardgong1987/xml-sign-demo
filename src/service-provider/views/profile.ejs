<%- include("_head", { title: "Signed in - JSL-online" }) %>

<h1>Signed in</h1>

<%
/*
 * A shell only. The server has no idea whether this browser is signed in — that is the
 * whole point of a self-contained token. The script asks /api/me with the token it kept
 * in localStorage; if the answer is 401 there is no valid sign-in and it starts SSO.
 */
%>
<p id="status">Checking the access token…</p>

<table id="profile" hidden></table>

<p><button id="sign-out" type="button" hidden>Sign out</button></p>

<script>
    const TOKEN_KEY = "sp_access_token";

    function startSingleSignOn() {
        localStorage.removeItem(TOKEN_KEY);
        location.replace(`/login?returnTo=${encodeURIComponent(location.pathname)}`);
    }

    function renderProfile(fields) {
        const table = document.getElementById("profile");

        for (const field of fields) {
            const row = table.insertRow();
            row.insertCell().textContent = field.label;
            row.insertCell().textContent = field.value;
        }

        document.getElementById("status").textContent =
            "Everything below travelled in the assertion the IdP signed, and now rides in this SP's own JWT.";
        table.hidden = false;
        document.getElementById("sign-out").hidden = false;
    }

    async function showSignedInUser() {
        const accessToken = localStorage.getItem(TOKEN_KEY);

        if (!accessToken) {
            startSingleSignOn();
            return;
        }

        const response = await fetch("/api/me", {
            headers: {authorization: `Bearer ${accessToken}`},
        });

        if (!response.ok) {
            startSingleSignOn();
            return;
        }

        renderProfile((await response.json()).fields);
    }

    // Signing out is purely local: the token is self-contained, so there is nothing on
    // the server to invalidate.
    document.getElementById("sign-out").addEventListener("click", () => {
        localStorage.removeItem(TOKEN_KEY);
        location.replace("/");
    });

    void showSignedInUser();
</script>

<%- include("_foot") %>

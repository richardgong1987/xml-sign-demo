<%- include("_head", { title: "Signed in - JSL-online" }) %>

<h1>Signed in</h1>

<p>Everything below comes from the assertion the IdP signed, and has passed both the
    signature check and the SAML protocol checks.</p>

<table>
    <% fields.forEach((field) => { %>
    <tr>
        <td><%= field.label %></td>
        <td><%= field.value %></td>
    </tr>
    <% }) %>
</table>

<form method="post" action="/logout">
    <button type="submit">Sign out</button>
</form>

<%- include("_foot") %>

{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {"include": "**/views/**/*.ejs", "outDir": "dist"},
      {"include": "**/public/**/*", "outDir": "dist"}
    ],
    "watchAssets": true
  }
}
